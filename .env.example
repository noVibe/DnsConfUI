# ---------------------------------------------------------------------------
# DnsConf UI — configuration
#
# Everything here is optional — the app runs with no .env file at all.
# Copy this file to .env only if you want to change something:
#   Windows:        copy .env.example .env
#   macOS / Linux:  cp .env.example .env
#
# .env is read by Docker Compose and is ignored by git, so your values stay
# on your machine.
#
# There is nothing to set up for GitHub here. The app ships with a client ID,
# and to authorize through an OAuth App of your own you paste its Client ID
# into the field on the app's own start screen: it takes effect at once, with
# no rebuild and no restart, and the container keeps it until it is restarted.
# ---------------------------------------------------------------------------

# Port on your own machine where the UI will be served — optional.
# The default gives you http://localhost:3000
# Change it if port 3000 is already in use, e.g. HOST_PORT=8080
HOST_PORT=3000
