# ---------------------------------------------------------------------------
# DnsConf UI — configuration
#
# Copy this file to .env and fill in the Client ID below:
#   Windows:        copy .env.example .env
#   macOS / Linux:  cp .env.example .env
#
# .env is read by Docker Compose and is ignored by git, so your values stay
# on your machine.
# ---------------------------------------------------------------------------

# GitHub OAuth App Client ID — REQUIRED, the app cannot sign you in without it.
#
# How to get one (takes about a minute):
#   1. open https://github.com/settings/developers
#   2. "New OAuth App": any name, any homepage URL (e.g. http://localhost:3000)
#   3. create it, then tick "Enable Device Flow" and save
#   4. copy the "Client ID" from the app page and paste it after the = below
#
# This value is not a secret: it is visible in the browser by design.
NEXT_PUBLIC_GITHUB_CLIENT_ID=

# Port on your own machine where the UI will be served — optional.
# The default gives you http://localhost:3000
# Change it if port 3000 is already in use, e.g. HOST_PORT=8080
HOST_PORT=3000
